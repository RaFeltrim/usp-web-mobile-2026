      "name": "cadastro-usuario-ct1-1",
      "commands": [
        {
          "id": "49d0439a-9702-41e3-bf11-519492960452",
          "comment": "",
          "command": "open",
          "target": "https://linamgr.github.io/cadastro-usuario/",
          "targets": [],
          "value": ""
        },
        {
          "id": "84564b07-6248-4763-bacd-bbee9d42197b",
          "comment": "",
          "command": "assertText",
          "target": "css=h2",
          "targets": [
            [
              "css=h2",
              "css:finder"
            ],
            [
              "xpath=//h2",
              "xpath:position"
            ],
            [
              "xpath=//h2[contains(.,'Cadastro de Usuário')]",
              "xpath:innerText"
            ]
          ],
          "value": "Cadastro de Usuário"
        },
        {
          "id": "a99a4030-6a76-468c-8726-77394988433a",
          "comment": "",
          "command": "executeScript",
          "target": "document.getElementById('inputName').value = 'Julian';",
          "targets": [],
          "value": "Julian"
        },
        {
          "id": "ba51d86e-970d-4786-9774-157a42a8226c",
          "comment": "",
          "command": "executeScript",
          "target": "document.getElementById('inputYear').value = '1991';",
          "targets": [],
          "value": "1991"
        },
        {
          "id": "5ff47f35-00c4-435a-9a7e-d78b2e4e8b78",
          "comment": "",
          "command": "executeScript",
          "target": "document.getElementById('inputEmail').value = 'jul@usp.br';",
          "targets": [],
          "value": "jul@usp.br"
        },
        {
          "id": "f21d827e-c82b-46ae-8c19-963949932879",
          "comment": "",
          "command": "executeScript",
          "target": "document.getElementById('inputPassword').value = '#@49%No74';",
          "targets": [],
          "value": "#@49%No74"
        },
        {
          "id": "ec149b00-b053-47a9-b66e-54798f6351c4",
          "comment": "",
          "command": "click",
          "target": "css=.btn",
          "targets": [
            [
              "css=.btn",
              "css:finder"
            ],
            [
              "xpath=//button[@type='submit']",
              "xpath:attributes"
            ],
            [
              "xpath=//form[@id='singleForm']/div[5]/button",
              "xpath:idRelative"
            ],
            [
              "xpath=//button",
              "xpath:position"
            ],
            [
              "xpath=//button[contains(.,'Enviar')]",
              "xpath:innerText"
            ]
          ],
          "value": ""
        },
        {
          "id": "afb2597b-a797-43b1-aae9-bd982a873c96",
          "comment": "",
          "command": "assertText",
          "target": "id=inputPasswordHelp",
          "targets": [
            [
              "id=inputPasswordHelp",
              "id"
            ],
            [
              "css=#inputPasswordHelp",
              "css:finder"
            ],
            [
              "xpath=//div[@id='inputPasswordHelp']",
              "xpath:attributes"
            ],
            [
              "xpath=//form[@id='singleForm']/div[4]/div",
              "xpath:idRelative"
            ],
            [
              "xpath=//form/div[4]/div",
              "xpath:position"
            ]
          ],
          "value": "Senha Moderada"
        },
        {
          "id": "3b20dfa2-d1d8-4505-885a-981b2b60c512",
          "comment": "",
          "command": "assertText",
          "target": "id=inputResult",
          "targets": [
            [
              "id=inputResult",
              "id"
            ],
            [
              "css=#inputResult",
              "css:finder"
            ],
            [
              "xpath=//div[@id='inputResult']",
